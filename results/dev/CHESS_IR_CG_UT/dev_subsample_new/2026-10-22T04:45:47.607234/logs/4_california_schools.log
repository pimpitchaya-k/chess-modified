	Phone TEXT null, -- Example Values: `('(510) 887-0152',)`, `('(510) 596-8901',)`, `('(510) 686-4131',)` | Value Statics: Total count 11717 - Distinct count 10632 - Null count 5969   
	StatusType TEXT not null, -- Example Values: `Active`, `Closed`, `Merged`, `Pending` | Value Statics: Total count 17686 - Distinct count 4 - Null count 0   
	CDSCode TEXT not null primary key,
	Charter INTEGER null, -- Example Values: `1`, `0` | Value Statics: Total count 16317 - Distinct count 2 - Null count 1369  | Column Description: This field identifies a charter school. | Value Description: The field is coded as follows:  ·       1 = The school is a charter  ·       0 = The school is not a charter
	OpenDate DATE null, -- Example Values: `('2005-08-29',)`, `('2006-08-28',)`, `('2008-08-21',)` | Value Statics: Total count 16317 - Distinct count 1406 - Null count 1369   
);

CREATE TABLE frpm
(
	foreign key (CDSCode) references schools (CDSCode),
	CDSCode TEXT not null primary key,
