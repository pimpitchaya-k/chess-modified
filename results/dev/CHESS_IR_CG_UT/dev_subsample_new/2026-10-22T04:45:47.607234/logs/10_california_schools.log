    "SQL": " WITH MaxReadingScore AS (     SELECT cds, MAX(AvgScrRead) AS MaxScore     FROM satscores     GROUP BY cds ) SELECT T3.`FRPM Count (Ages 5-17)` FROM satscores AS T1 JOIN schools AS T2 ON T1.cds = T2.CDSCode JOIN frpm AS T3 ON T2.CDSCode = T3.CDSCode WHERE T1.AvgScrRead = (SELECT MaxScore FROM MaxReadingScore WHERE T1.cds = MaxReadingScore.cds) ",
